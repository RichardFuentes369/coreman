## SERVER ON
PORT = 3000

## MODE
NODE_ENV=production

## JWT
JWT_EXPIRATION_MS=seconds
JWT_SECRET_ADMIN=secret_admin
JWT_SECRET_USER=secret_user

## BLOQUEO DE LOGIN (admin)
ADMIN_MAX_LOGIN_ATTEMPTS=3
ADMIN_LOCKOUT_MINUTES=10

## MYSQL
DATABASEHOST = host_db
DATABASEPORT = port_db
DATABASEUSERNAME = user_db
DATABASEPASSWORD = password_db
DATABASENAME = example_db
FALLBACK_LANG= es

## MONGO
MONGODB = mongodb://localhost:27017/core